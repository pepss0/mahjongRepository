<Window x:Name="___nessun_nome_" x:Class="mahjong.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mahjong"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="DarkGreen">
        <!-- 1. Il Canvas di gioco: qui dentro aggiungerai SOLO le tessere via codice C# -->
        <Canvas x:Name="TavoloDiGioco"/>

        <!-- 2. Il bottone Restart: si trova nella Grid principale, quindi NON verrà mai toccato da Children.Clear() -->
        <Button x:Name="RestartButton" Content="RESTART" 
            HorizontalAlignment="Right" VerticalAlignment="Top" 
            Margin="20" Height="47" Width="78" 
            FontFamily="Segoe UI Black" Click="RestartButton_Click"/>
    </Grid>

</Window>
